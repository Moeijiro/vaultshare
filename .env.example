# Copy to .env (next to this file or in backend/). Every value has a development default.
ENV=development
# Origins allowed to call the API from a browser (the Next.js app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=sqlite+aiosqlite:///./vaultshare.db

# With ENV=production the API refuses to start while these two are the development defaults.
# Master key: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# VAULT_MASTER_KEY=
# JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Set true behind HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false

# Encrypted files live here, outside the web root.
STORAGE_DIR=./vault_storage
MAX_FILE_SIZE_BYTES=10485760
MAX_PASSWORD_ATTEMPTS=5
# How often expired or used-up secrets are shredded, in seconds.
CLEANUP_INTERVAL_SECONDS=300
