# ==========================================
# VaultShare Configuration
# ==========================================

# Server
PROJECT_NAME="VaultShare"
ENV="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Security & Master Encryption Key (32 bytes base64 encoded or hex)
# Generate with: python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
VAULT_MASTER_KEY="dGVzdF9tYXN0ZXJfa2V5XzMyX2J5dGVzX2xvbmdfc2VjdXJlIQ=="
JWT_SECRET="vaultshare_jwt_super_secret_key_change_in_production_32bytes"
JWT_ALGORITHM="HS256"
# With ENV="production" the API refuses to start while the two values above are the development defaults.
# Generate a master key: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./vaultshare.db"

# Storage
STORAGE_DIR="./vault_storage"
MAX_FILE_SIZE_MB=10
DEFAULT_EXPIRATION_HOURS=24
CLEANUP_INTERVAL_SECONDS=300
